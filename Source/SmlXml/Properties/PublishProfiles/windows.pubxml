<?xml version="1.0" encoding="utf-8"?>
<!-- The only publish profile for smlxml, used by both Visual Studio (Publish) and the command line:
       dotnet publish Source/SmlXml/SmlXml.csproj -p:PublishProfile=windows
     Writes both Windows executables at the repository root, each as one framework-dependent file with
     LICENSE.md beside it:
       publish\smlxml\win-x64\smlxml.exe   64-bit, needs the x64 .NET 10 runtime
       publish\smlxml\win-x86\smlxml.exe   32-bit, needs the x86 .NET 10 runtime
     The profile publishes win-x64; the PublishAdditionalRuntimes target in SmlXml.csproj then publishes each
     runtime in AdditionalPublishRuntimes the same way. PublishProtocol and _TargetId make Visual Studio list
     this as a folder profile. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AdditionalPublishRuntimes>win-x86</AdditionalPublishRuntimes>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\publish\smlxml\$(RuntimeIdentifier)\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
