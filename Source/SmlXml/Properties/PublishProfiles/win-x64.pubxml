<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes smlxml.exe for 64-bit Windows as one framework-dependent file (requires the .NET 10 runtime).
     Usage: dotnet publish Source/SmlXml/SmlXml.csproj -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\smlxml\</PublishDir>
  </PropertyGroup>
</Project>
