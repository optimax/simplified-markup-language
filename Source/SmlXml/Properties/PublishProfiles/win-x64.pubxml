<?xml version="1.0" encoding="utf-8"?>
<!-- The only publish profile for smlxml, used by both Visual Studio (Publish) and the command line:
       dotnet publish Source/SmlXml/SmlXml.csproj -p:PublishProfile=win-x64
     Writes publish\smlxml\smlxml.exe at the repository root as one framework-dependent file for 64-bit
     Windows (requires the .NET 10 runtime), with LICENSE.md beside it.
     PublishProtocol and _TargetId make Visual Studio list this as a folder profile. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\publish\smlxml\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
